{$DEPLOY_DOMAIN} {
  encode gzip
  root * /srv

  handle /api/health {
    rewrite * /health
    reverse_proxy backend:8080
  }

  handle /api/* {
    reverse_proxy backend:8080
  }

  handle /assets/* {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}
