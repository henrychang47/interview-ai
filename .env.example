# Application
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
INTERVIEW_CREATION_LIMIT_PER_24H=5
# Required outside development. Generate a long random value for production.
IP_HASH_SALT=

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=interview_ai
POSTGRES_PASSWORD=interview_ai_dev_password
POSTGRES_DB=interview_ai

# Frontend dev server
VITE_API_PROXY_TARGET=http://backend:8080
VITE_MAX_ANSWER_RECORDING_SECONDS=180

# Gemini question generation
# Leave GEMINI_API_KEY empty to use mock question generation and mock answer analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Gemini answer analysis
# Empty values reuse GEMINI_MODEL and GEMINI_FALLBACK_MODEL.
GEMINI_ANSWER_MODEL=
GEMINI_ANSWER_FALLBACK_MODEL=

# Gemini question TTS
# Reuses GEMINI_API_KEY. If unavailable, the frontend falls back to browser TTS.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACK_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
