# Application
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=interview_ai
POSTGRES_PASSWORD=interview_ai_dev_password
POSTGRES_DB=interview_ai

# Frontend dev server
VITE_API_PROXY_TARGET=http://backend:8080
VITE_MAX_ANSWER_RECORDING_SECONDS=180

# Gemini question generation
# Leave GEMINI_API_KEY empty to use mock question generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
