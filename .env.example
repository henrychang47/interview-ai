# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=interview_ai
POSTGRES_PASSWORD=interview_ai_dev_password
POSTGRES_DB=interview_ai

# Frontend dev server
VITE_API_PROXY_TARGET=http://backend:8080

# OpenAI question generation
# Leave OPENAI_API_KEY empty to use mock question generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
